{
  "name": "takehomelab",
  "compatibility_date": "2026-09-22",
  "main": "worker.js",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": true
  },
  "workers_dev": false,
  "routes": [
    { "pattern": "takehomelab.co.uk", "custom_domain": true },
    { "pattern": "www.takehomelab.co.uk", "custom_domain": true }
  ]
}
